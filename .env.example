# Copy this file to .env and fill in your values:  cp .env.example .env

# Required: your Euri API key
EURI_API_KEY=your-euri-api-key-here

# Optional: Euri Live websocket endpoint
EURI_LIVE_URL=wss://api.euron.one/api/v1/euri/live/sessions

# Optional: voice model (listens + speaks)
EURI_LIVE_MODEL=gpt-live-1

# Optional: brain model (reasoning + web search)
EURI_BRAIN_MODEL=gpt-6-luna
